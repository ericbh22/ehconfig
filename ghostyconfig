# Active preferences captured from the current Mac, with duplicated/malformed
# template blocks removed. Keep the historical filename for existing users.
theme = Catppuccin Mocha
macos-titlebar-style = transparent
window-decoration = true
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 80%, 80%
clipboard-read = allow
clipboard-write = allow
background-opacity = 0.8
keybind = shift+enter=text:\x1b\r
cursor-style = block

# Optional current-Mac cursor effect: see README before enabling.
# custom-shader = shaders/cursor_warp.glsl
# custom-shader-animation = true
